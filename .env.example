# Copy this file to .env and fill in the values, then `docker compose up -d`.

# --- Required ---

# Twitch application credentials from https://dev.twitch.tv/console/apps
# Register the OAuth redirect URL as PUBLIC_URL/auth/callback, e.g.
# http://localhost:8477/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch logins allowed to sign in as admins.
TWITCHMARKOV_ADMINS=

# --- Optional ---

# Base URL the bot is reachable at; used to build the OAuth redirect and
# links in chat replies (e.g. `!commands`). Must match the redirect URL
# registered with your Twitch application.
#PUBLIC_URL=http://localhost:8477

# SQLAlchemy async database URL. Defaults to a SQLite file relative to the
# working directory (./data/twitchmarkov.db) -- this path is independent of
# DATA_DIR below, it is not derived from it. The Dockerfile overrides this
# default to /data/twitchmarkov.db, matching the ./data bind mount; leave
# unset to use that when running with Docker. For MariaDB (see the `mysql`
# compose profile), use something like:
#DATABASE_URL=mysql+aiomysql://twitchmarkov:twitchmarkov@mariadb:3306/twitchmarkov

# Secret used to sign session cookies. If unset, one is generated once and
# stored in the database.
#SESSION_SECRET=

# Allow non-admin broadcasters to add/remove their own channel from the web
# UI (they can always edit settings for a channel they already own).
#ALLOW_SELF_SERVICE=false

#LOG_LEVEL=INFO
#HOST=0.0.0.0
#PORT=8477

# Directory for log files only (DATA_DIR/logs/) -- does NOT affect where the
# SQLite database goes; see DATABASE_URL above for that. The Dockerfile sets
# this to /data, matching the ./data bind mount in docker-compose.yml —
# leave unset when running with Docker.
#DATA_DIR=./data

# --- MariaDB service (only used with `docker compose --profile mysql up`) ---
# Must match the credentials in the DATABASE_URL above.
#MARIADB_PASSWORD=twitchmarkov
#MARIADB_ROOT_PASSWORD=changeme
